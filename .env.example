# 复制为 .env 并填值（.env 已在 .gitignore 中，禁止提交）
POSTGRES_USER=muti
POSTGRES_PASSWORD=change-me-local
POSTGRES_DB=muti_dev
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me-local

# LiteLLM 网关（模型 key 一律经网关分发，agent 只拿角色虚拟 key）
LITELLM_MASTER_KEY=change-me
# 各模型供应商 key（只在本文件与 CI secrets 出现，禁止进代码/日志/prompt）
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# PII 保险库主密钥（T-W4-031，D7）：32 字节 base64，AES-256-GCM 列级加密
# 生成：python -c "from src.core.compliance.pii_encryption import generate_master_key; print(generate_master_key())"
PII_VAULT_KEY=change-me-base64-32bytes

# API 边界加固（T-W5-008，全部有安全默认值，未配置即默认行为）：
# CORS Origin 白名单（逗号分隔；默认空 = 拒绝一切跨域请求）
# API_CORS_ALLOWED_ORIGINS=https://school.example.com
# CORS 显式凭据模式（默认关闭；开启后响应携带 Access-Control-Allow-Credentials: true）
# API_CORS_ALLOW_CREDENTIALS=true
# 限流 RPM 覆盖（每分钟请求数；默认：作答提交 30 / 报告查询 60 / 其余 120）
# API_RATE_LIMIT_SUBMIT_RPM=30
# API_RATE_LIMIT_REPORT_RPM=60
# API_RATE_LIMIT_DEFAULT_RPM=120
# 请求体上限字节（默认 1048576 = 1 MiB）
# API_MAX_BODY_BYTES=1048576
